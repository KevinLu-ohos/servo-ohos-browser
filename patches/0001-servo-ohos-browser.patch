+  @Builder
+  icon(glyph: string, size: number, color: ResourceColor, stroke: number) {
+    GlyphIcon({
+      glyph: glyph,
+      iconSize: size,
+      iconStroke: stroke,
+      iconColor: color,
+      iconOffset: 2.5
+    })
