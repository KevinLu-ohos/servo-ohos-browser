+        .onClick(() => {
+          this.closeTab(index);
+        })
+      }
+    }
+    .width(TAB_W)
+    .height(34)
+    .padding({ left: 12, right: 6 })
+    .translate({ x: this.tabShift(index) })
+    .borderRadius(12)
+    .backgroundColor(this.activeId === tab.id ? this.surface() : Color.Transparent)
+    .border({
+      width: 1,
+      color: this.activeId === tab.id ? this.line() : Color.Transparent
+    })
