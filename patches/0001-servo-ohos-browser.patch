+        "buf={:?} size={:?} css={:?} dpr={hidpi:.2}",
+        buffer_size.map(|s| (s.width, s.height)),
+        reported_size.map(|s| (s.width, s.height)),
+        css,
+    );
+    (buffer_size, reported_size, hidpi)
