+  /** 内核没给 favicon 时，自己去找：页面声明的 icon → /favicon.ico。 */
+  private async fetchSiteIcon(tab: TabInfo): Promise<void> {
+    if (tab.favicon !== null || tab.isNewTab || tab.url.length === 0) {
+      return;
+    }
+    if (!tab.url.startsWith('http')) {
