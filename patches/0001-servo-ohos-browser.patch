+    .animation({ curve: tabSpring(), duration: 380 })
+    .hoverEffect(HoverEffect.Highlight)
+  }
+
+  @Builder
+  tabDragWrapper(tab: TabInfo, index: number) {
+    Column() {
+      this.tabPill(tab, index)
+    }
+    .translate({ x: this.dragIndex === index ? this.dragDx : 0 })
+    .rotate({ angle: this.dragIndex === index ? this.tabTilt() : 0 })
+    .zIndex(this.dragIndex === index ? 30 : 1)
+    .stateStyles({
+      pressed: { .scale({ x: 0.96, y: 0.96 }) },
+      normal: { .scale({ x: 1, y: 1 }) }
+    })
+    .transition(TransitionEffect.OPACITY
+      .combine(TransitionEffect.scale({ x: 0.7, y: 0.7 }))
+      .animation({ curve: bounce(), duration: 300 }))
+    .onHover((isHover: boolean) => {
+      this.hoveredKey = isHover ? 'tab' + index : '';
+    })
+    .onClick(() => {
+      this.selectTab(index);
+    })
+    .gesture(
+      PanGesture({ fingers: 1, distance: 6 })
+        .onActionStart(() => {
+          animateTo({ curve: press(), duration: 180 }, () => {
+            this.dragIndex = index;
+            this.dragTarget = index;
+            this.dragDx = 0;
+          });
+        })
+        .onActionUpdate((event: GestureEvent) => {
+          if (this.dragIndex !== index) {
+            return;
+          }
+          this.dragDx = event.offsetX;
+          const steps = Math.round(event.offsetX / TAB_W);
+          const next = Math.min(Math.max(index + steps, 0), this.tabs.length - 1);
+          if (next !== this.dragTarget) {
+            this.dragTarget = next;
+          }
+        })
+        .onActionEnd(() => {
+          if (this.dragIndex === index) {
+            this.onTabDragEnd(index);
+          }
+        })
+        .onActionCancel(() => {
+          animateTo({ curve: bounce(), duration: 320 }, () => {
+            this.dragDx = 0;
+            this.dragIndex = -1;
+            this.dragTarget = -1;
+          });
+        })
+    )
+  }
