+  /** 首页 logo 尺寸：随窗口宽度缩放，夹在 96..200 之间。 */
+  private newTabLogoSize(): number {
+    const base: number = this.winW > 0 ? this.winW : 1280;
+    return Math.max(96, Math.min(200, base * 0.13));
+  }
+
+  /** 首页输入框宽度：随窗口宽度缩放，夹在 360..760 之间。 */
+  private newTabFieldWidth(): number {
+    const base: number = this.winW > 0 ? this.winW : 1280;
+    return Math.max(360, Math.min(760, base * 0.56));
+  }
+
+  /** 首页输入框高度：随窗口高度缩放，夹在 48..64 之间。 */
+  private newTabFieldHeight(): number {
+    const base: number = this.winH > 0 ? this.winH : 800;
+    return Math.max(48, Math.min(64, base * 0.075));
+  }
+
+  /**
+   * 工具栏图标按钮。
+   * 按下缩放由 pressedKey 管理并在 Up/Cancel/Click 三处复位：
+   * 用 stateStyles 的 pressed 缩放时，若点击引发重绘（导航、刷新）会丢 Up 事件，
+   * 按钮就永久停在缩放态——这正是“浏览网页后按钮自己变小”的原因。
+   */
+  @Builder
+  tbButton(glyph: string, key: string, action: () => void) {
+    Column() {
+      this.iconCenter(glyph, 24, this.iconInk(), 2)
+    }
+    .width(48)
+    .height(48)
+    .justifyContent(FlexAlign.Center)
+    .borderRadius(14)
+    .backgroundColor(Color.Transparent)
+    .hoverEffect(HoverEffect.Highlight)
+    .scale(this.pressedKey === key ? { x: 0.9, y: 0.9 } : { x: 1, y: 1 })
+    .animation({ curve: bounce(), duration: 200 })
+    .onTouch((event: TouchEvent) => {
+      if (event.type === TouchType.Down) {
+        this.pressedKey = key;
+      } else if (event.type === TouchType.Up || event.type === TouchType.Cancel) {
+        this.pressedKey = '';
+      }
+    })
+    .onClick(() => {
+      this.pressedKey = '';
+      action();
+    })
+  }
+
+  /** 独立按钮里的图标：不做文字对齐偏移，严格居中。 */
