+/**
+ * 图标组件。
+ * 用 @Component + @Prop 而不是 @Builder：@Builder 的参数是按值传递，
+ * 颜色变了不会重绘，切换深浅色时图标会停在旧颜色（这正是“图标还是灰色”的原因）。
+ */
+@Component
+struct GlyphIcon {
+  @Prop glyph: string = '';
+  @Prop iconSize: number = 24;
+  @Prop iconStroke: number = 2;
+  @Prop iconColor: ResourceColor = '#111111';
+  /** 文字行盒含下沉部，图标下移一点才能与文字光学对齐。 */
+  @Prop iconOffset: number = 2.5;
+  /** 与文字并排时为 true（下移 2.5vp 对齐光学中线）；独立按钮里必须为 false。 */
+  @Prop alignToText: boolean = true;
+  /** 独立按钮里的位移（默认右下各 3vp）；个别图标需要微调时单独传入。 */
+  @Prop shiftX: number = 3.0;
+  @Prop shiftY: number = 3.0;
+
+  build() {
+    Stack({ alignContent: Alignment.Center }) {
+      Shape() {
+        Path()
+          .commands(glyphPathFor(this.glyph))
+          .stroke(this.iconColor)
+          .strokeWidth(this.iconStroke)
+          .fill(Color.Transparent)
+          .strokeLineCap(LineCapStyle.Round)
+          .strokeLineJoin(LineJoinStyle.Round)
+      }
+      .width(this.iconSize)
+      .height(this.iconSize)
+      .viewPort({ x: 0, y: 0, width: 24, height: 24 })
+      // 与文字并排时只做竖直光学对齐；独立按钮里实测整体偏左上，
+      // 需要右下各移 2.2vp（≈3px）才落在待选框正中。
+      .offset({ x: this.alignToText ? 0 : this.shiftX,
+        y: this.alignToText ? this.iconOffset : this.shiftY })
+    }
+    .width(this.iconSize)
+    .height(this.iconSize)
+  }
+}
 
