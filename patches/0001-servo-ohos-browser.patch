new file mode 100644
index 000000000..5bfeb59d5
--- /dev/null
+++ b/support/openharmony/entry/src/main/ets/common/Store.ets
@@ -0,0 +1,102 @@
+import { preferences } from '@kit.ArkData';
+import { common } from '@kit.AbilityKit';
+
+const STORE_NAME: string = 'servo_browser_store';
+
+export class Settings {
+  searchEngine: string = 'bing';
+  theme: string = 'auto';
+  restoreSession: boolean = true;
+  homePage: string = 'https://servo.org';
+  glass: boolean = true;
+}
+
+export class UserScript {
+  id: number = 0;
+  name: string = '';
+  pattern: string = '';
+  code: string = '';
+  enabled: boolean = true;
+}
+
+/**
+ * Thin wrapper over `@ohos.data.preferences`.
+ *
+ * Everything the browser chrome needs to remember (settings, open session, user scripts)
+ * lives here; it is written synchronously because the payloads are tiny.
+ */
+export class Store {
+  private static pref: preferences.Preferences | null = null;
+
+  static init(context: common.Context): void {
+    if (Store.pref === null) {
+      Store.pref = preferences.getPreferencesSync(context, { name: STORE_NAME });
+    }
+  }
+
+  static getString(key: string, def: string): string {
+    if (Store.pref === null) {
+      return def;
+    }
+    return Store.pref.getSync(key, def) as string;
+  }
+
+  static getBool(key: string, def: boolean): boolean {
+    if (Store.pref === null) {
+      return def;
+    }
+    return Store.pref.getSync(key, def) as boolean;
+  }
+
+  static put(key: string, value: string | boolean): void {
+    if (Store.pref === null) {
+      return;
+    }
+    Store.pref.putSync(key, value);
+    Store.pref.flush();
+  }
+
+  static loadSettings(): Settings {
+    const settings = new Settings();
+    settings.searchEngine = Store.getString('searchEngine', 'bing');
+    settings.theme = Store.getString('theme', 'auto');
+    settings.restoreSession = Store.getBool('restoreSession', true);
+    settings.homePage = Store.getString('homePage', 'https://servo.org');
+    settings.glass = Store.getBool('glass', true);
+    return settings;
+  }
+
+  static saveSettings(settings: Settings): void {
+    Store.put('searchEngine', settings.searchEngine);
+    Store.put('theme', settings.theme);
+    Store.put('restoreSession', settings.restoreSession);
+    Store.put('homePage', settings.homePage);
+    Store.put('glass', settings.glass);
+  }
+
+  static loadScripts(): UserScript[] {
+    const raw = Store.getString('scripts', '[]');
+    try {
+      return JSON.parse(raw) as UserScript[];
+    } catch (error) {
+      return [];
+    }
+  }
+
+  static saveScripts(scripts: UserScript[]): void {
+    Store.put('scripts', JSON.stringify(scripts));
+  }
+
+  static loadSession(): string[] {
+    const raw = Store.getString('session', '[]');
+    try {
+      return JSON.parse(raw) as string[];
+    } catch (error) {
+      return [];
+    }
+  }
+
+  static saveSession(urls: string[]): void {
+    Store.put('session', JSON.stringify(urls));
+  }
+}
