+class DownloadItem {
+  id: number;
+  name: string;
+  url: string;
+  progress: number;
+  status: string;
+  path: string;
+  savedTo: string;
+  /** 已下载字节数 / 总字节数 */
+  received: number;
+  total: number;
+  /** 实时速率（字节/秒） */
+  speed: number;
+  private lastTick: number;
+  private lastReceived: number;
+
+  constructor(id: number, name: string, url: string, path: string) {
+    this.id = id;
+    this.name = name;
+    this.url = url;
+    this.progress = 0;
+    this.status = '准备中';
+    this.path = path;
+    this.savedTo = '';
+    this.received = 0;
+    this.total = 0;
+    this.speed = 0;
+    this.lastTick = 0;
+    this.lastReceived = 0;
+  }
+
+  /** 更新进度并按时间差估算速率。 */
+  updateBytes(received: number, total: number): void {
+    const now: number = Date.now();
+    if (this.lastTick > 0) {
+      const seconds: number = (now - this.lastTick) / 1000;
+      if (seconds >= 0.2) {
+        const delta: number = received - this.lastReceived;
+        this.speed = delta > 0 ? delta / seconds : 0;
+        this.lastTick = now;
+        this.lastReceived = received;
+      }
+    } else {
+      this.lastTick = now;
+      this.lastReceived = received;
+    }
+    this.received = received;
+    if (total > 0) {
+      this.total = total;
+      this.progress = received / total;
+    }
+  }
+}
