+
+  @Builder
+  newTabView() {
+    // 输入框严格落在窗口垂直中心，logo 悬在其上方；
+    // Stack 空白区域不参与命中测试，避免遮挡顶栏按钮。
+    // 尺寸全部由窗口大小推导，窗口拉大/缩小都保持同一比例。
+    Stack({ alignContent: Alignment.Center }) {
+      Column() {
+        Image($r('app.media.servo_1024'))
+          .width(this.newTabLogoSize())
+          .height(this.newTabLogoSize())
+          .objectFit(ImageFit.Contain)
+          .draggable(false)
+      }
+      .offset({ y: -(this.newTabLogoSize() * 0.55 + this.newTabFieldHeight() * 1.1) })
+
+      Row({ space: 10 }) {
+        TextInput({ text: $$this.newTabQuery, placeholder: '搜索 Servo 或输入网址' })
+          .layoutWeight(1)
+          .height(this.newTabFieldHeight() - 8)
+          .fontSize(this.newTabFieldHeight() * 0.3)
+          .fontColor(this.fg())
+          .placeholderColor(this.fgDim())
+          .backgroundColor(Color.Transparent)
+          .padding({ left: 0, right: 0 })
+          .enableKeyboardOnFocus(true)
+          .id('newtab-input')
+          .onSubmit(() => {
+            this.newTabNavigate();
+          })
+
+        Text('前往')
+          .fontSize(this.newTabFieldHeight() * 0.28)
+          .fontColor(Color.White)
+          .padding({ left: 20, right: 20, top: 11, bottom: 11 })
+          .borderRadius(22)
+          .backgroundColor(ACCENT)
+          .stateStyles({
+            pressed: { .scale({ x: 0.95, y: 0.95 }) },
+            normal: { .scale({ x: 1, y: 1 }) }
+          })
+          .animation({ curve: bounce(), duration: 200 })
+          .onClick(() => {
+            this.newTabNavigate();
+          })
+      }
+      .width(this.newTabFieldWidth())
+      .height(this.newTabFieldHeight())
+      .padding({ left: 20, right: 8 })
+      .borderRadius(this.newTabFieldHeight() * 0.5)
+      .backgroundColor(this.fieldBg())
+      .border({ width: 1, color: this.line() })
+    }
+    .width('100%')
+    .height('100%')
+    .hitTestBehavior(HitTestMode.Transparent)
+  }
