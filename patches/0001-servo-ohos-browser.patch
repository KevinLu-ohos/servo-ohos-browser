+  }
+
+  /** 玻璃顶部高光（模拟厚度与折射）。 */
+  private highlight(): string {
+    return this.isDark ? '#1AFFFFFF' : '#8CFFFFFF';
+  }
+
+  private immersiveStyle(): uiMaterial.ImmersiveStyle {
+    if (this.ambient < 40) {
+      return uiMaterial.ImmersiveStyle.ULTRA_THICK;
+    }
+    if (this.ambient < 90) {
+      return uiMaterial.ImmersiveStyle.THICK;
+    }
+    return uiMaterial.ImmersiveStyle.REGULAR;
+  }
+
+  /** 只有系统材质真的可用时才走材质分支，避免材质与自绘底色互相覆盖。 */
+  private useMaterial(): boolean {
+    return this.materialOk && this.glass && this.immersiveWanted;
+  }
+
+  private rebuildMaterials(): void {
+    this.chromeMat = undefined;
+    this.panelMat = undefined;
+    this.tabDragMat = undefined;
+    this.materialOk = false;
+    if (!this.immersiveWanted) {
+      return;
+    }
+    try {
+      if (!uiMaterial.isImmersiveMaterialSupported()) {
+        JsLog.write('I', 'material: unsupported');
+        return;
+      }
+      // 注意：materialColor 默认是 Color.Transparent，材质会“可用但看不见”，
+      // 必须显式给材质层着色，玻璃才有实体。
+      this.chromeMat = new uiMaterial.ImmersiveMaterial({
+        style: this.immersiveStyle(),
+        // 必须不透明：沉浸材质会按**系统**外观着色，半透明时背景跟系统、
+        // 图标跟我们的主题，浅色下就会出现“白图标配浅底”看不见的情况。
+        materialColor: this.isDark ? '#FF1F2023' : '#FFFFFFFF',
+        applyShadow: true,
+        interactive: true,
+        lightEffect: { color: this.isDark ? '#66FFFFFF' : '#4DFFFFFF' }
+      });
+      this.panelMat = new uiMaterial.ImmersiveMaterial({
+        style: uiMaterial.ImmersiveStyle.ULTRA_THICK,
+        materialColor: this.isDark ? '#FF232427' : '#FFFFFFFF',
+        applyShadow: true,
+        interactive: true,
+        lightEffect: { color: this.isDark ? '#40FFFFFF' : '#33FFFFFF' }
+      });
+      this.tabDragMat = new uiMaterial.ImmersiveMaterial({
+        style: uiMaterial.ImmersiveStyle.ULTRA_THIN,
+        materialColor: this.isDark ? '#40FFFFFF' : '#99FFFFFF',
+        applyShadow: true,
+        interactive: true,
+        lightEffect: { color: this.isDark ? '#4DFFFFFF' : '#80FFFFFF' }
+      });
+      this.materialOk = true;
+      JsLog.write('I', 'material: ready');
+    } catch (error) {
+      this.materialOk = false;
+      JsLog.write('E', 'material: failed');
+    }
+  }
+
+  // ==================== 矢量图标 ====================
+  glyphPathPublic(glyph: string): string {
+    return glyphPathFor(glyph);
+  }
