+/// 读取 native window 缓冲区的真实像素尺寸。这是绘制表面唯一权威的大小来源。
+fn get_buffer_geometry(window: *mut c_void) -> Option<Size2D<i32, DevicePixel>> {
+    let mut height: i32 = 0;
+    let mut width: i32 = 0;
