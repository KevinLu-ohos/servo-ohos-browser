+    .onKeyEvent((event: KeyEvent) => {
+      // 网页内输入框的兜底：内核键盘事件不可靠时，由 ArkUI 转发字符
+      if (event.type !== KeyType.Down || this.onNewTab || this.omniboxFocused) {
+        return;
+      }
+      const code: number = event.unicode !== undefined ? event.unicode : 0;
+      if (code >= 32 && code !== 127) {
+        const text: string = String.fromCharCode(code);
+        this.safe('insertText', () => { servoshell.insertText(text); });
+      }
+    })
   }
