+
+  // ==================== 路由 ====================
+  private openPanel(name: string): void {
+    this.backTo = this.view === name ? 'browser' : this.view;
+    this.view = name;
+    // 只刷新头部元信息，日志本体由调试页自己的 onAppear 加载。
+    this.safe('viewportDiagnostics', () => {
+      this.viewportInfo = servoshell.viewportDiagnostics();
+    });
+    this.safe('imeStatus', () => {
+      this.imeInfo = servoshell.imeStatus();
+    });
+  }
+
+  private backPanel(): void {
+    this.view = this.backTo;
+    this.backTo = 'browser';
+  }
+
+  private runMenuAction(id: number): void {
+    if (id === 1) {
+      this.newTab();
+    } else if (id === 2) {
+      this.openPanel('downloads');
+    } else if (id === 3) {
+      this.openPanel('extensions');
+    } else if (id === 4) {
+      this.openPanel('settings');
+    } else if (id === 5) {
+      this.themeMode = this.isDark ? 'light' : 'dark';
+      this.applyThemeMode();
+      this.persistSettings();
+    }
+  }
+
+  // ==================== 标签 ====================
+  private tabIds(): number[] {
+    const ids: number[] = [];
+    for (let i = 0; i < this.tabs.length; i++) {
+      ids.push(this.tabs[i].id);
+    }
+    return ids;
+  }
+
+  private activeIndex(): number {
+    for (let i = 0; i < this.tabs.length; i++) {
+      if (this.tabs[i].id === this.activeId) {
+        return i;
+      }
+    }
+    return 0;
+  }
+
+  private updateActiveTab(title: string | null, url: string | null, loading: boolean | null): void {
+    for (let i = 0; i < this.tabs.length; i++) {
+      const tab = this.tabs[i];
+      if (tab.id !== this.activeId) {
+        continue;
+      }
+      if (title !== null) {
+        tab.title = title.length > 0 ? title : '新标签页';
+      }
+      if (url !== null) {
+        tab.url = url;
+      }
+      if (loading !== null) {
+        tab.loading = loading;
+      }
+    }
+    this.tabs = this.tabs.slice();
+  }
+
+  private newTab(): void {
+    const id = this.nextTabId++;
+    this.safe('nextWindowId', () => { servoshell.nextWindowId(id); });
+    this.tabs.push(new TabInfo(id));
+    this.tabs = this.tabs.slice();
+    this.activeId = id;
+    this.urlInput = '';
+    this.loading = false;
+    this.progress = 0;
+    this.progressVisible = false;
+    this.view = 'browser';
+    this.onNewTab = true;
+    this.newTabQuery = '';
+    this.persistSession();
+  }
+
+  private closeTab(index: number): void {
+    if (index < 0 || index >= this.tabs.length) {
+      return;
+    }
+    // 最后一个标签不关闭，回到主页（Chromium 行为）
+    if (this.tabs.length === 1) {
+      const tab = this.tabs[0];
+      tab.title = '新标签页';
+      tab.url = '';
+      tab.loading = false;
+      this.tabs = this.tabs.slice();
+      this.urlInput = '';
+      this.onNewTab = true;
+      this.newTabQuery = '';
+      this.persistSession();
+      return;
+    }
+    const closingId = this.tabs[index].id;
+    this.safe('deleteWebview', () => { servoshell.deleteWebview(index, this.tabIds()); });
+    animateTo({ curve: bounce(), duration: 300 }, () => {
+      this.tabs.splice(index, 1);
+      this.tabs = this.tabs.slice();
+    });
+    if (closingId === this.activeId) {
+      const nextIndex = index >= this.tabs.length ? this.tabs.length - 1 : index;
+      this.activeId = this.tabs[nextIndex].id;
+      this.onNewTab = this.tabs[nextIndex].isNewTab;
+      this.safe('focusWebview', () => { servoshell.focusWebview(nextIndex, this.tabIds()); });
+      this.urlInput = this.tabs[nextIndex].url;
+    }
+    this.persistSession();
+  }
+
+  private selectTab(index: number): void {
+    if (index < 0 || index >= this.tabs.length) {
+      return;
+    }
+    const tab = this.tabs[index];
+    if (tab.id === this.activeId) {
+      this.view = 'browser';
+      return;
+    }
+    this.activeId = tab.id;
+    this.urlInput = tab.url;
+    this.loading = tab.loading;
+    this.onNewTab = tab.isNewTab;
+    this.view = 'browser';
+    this.safe('focusWebview', () => { servoshell.focusWebview(index, this.tabIds()); });
+  }
+
+  private nextTab(): void {
+    if (this.tabs.length < 2) {
+      return;
+    }
+    this.selectTab((this.activeIndex() + 1) % this.tabs.length);
+  }
+
+  private moveTab(from: number, to: number): void {
+    if (from < 0 || to < 0 || from >= this.tabs.length || to >= this.tabs.length || from === to) {
+      return;
+    }
+    const moved = this.tabs.splice(from, 1)[0];
+    this.tabs.splice(to, 0, moved);
+    this.tabs = this.tabs.slice();
+    this.persistSession();
+    this.safe('focusWebview', () => { servoshell.focusWebview(this.activeIndex(), this.tabIds()); });
+  }
+
+  /** 拖动时其它标签实时让位：越过一个位宽就让一个身位。 */
+  private tabShift(index: number): number {
+    if (this.dragIndex < 0 || this.dragTarget < 0) {
+      return 0;
+    }
+    if (index === this.dragIndex) {
+      return 0;
+    }
+    if (this.dragIndex < index && index <= this.dragTarget) {
+      return -(TAB_W + 4);
+    }
+    if (this.dragIndex > index && index >= this.dragTarget) {
+      return TAB_W + 4;
+    }
+    return 0;
+  }
+
+  /** 被拎起时随位移轻微倾斜，增强“拿在手里”的手感。 */
+  private tabTilt(): number {
+    const angle: number = this.dragDx * 0.012;
+    return Math.max(Math.min(angle, 3.5), -3.5);
+  }
+
+  private onTabDragEnd(index: number): void {
+    const to = this.dragTarget < 0 ? index : this.dragTarget;
+    animateTo({ curve: bounce(), duration: 420 }, () => {
+      if (to !== index && to >= 0 && to < this.tabs.length) {
+        const moved = this.tabs.splice(index, 1)[0];
+        this.tabs.splice(to, 0, moved);
+        this.tabs = this.tabs.slice();
+      }
+      this.dragDx = 0;
+      this.dragIndex = -1;
+      this.dragTarget = -1;
+    });
+    if (to !== index) {
+      this.persistSession();
+      this.safe('focusWebview', () => {
+        servoshell.focusWebview(this.activeIndex(), this.tabIds());
+      });
+    }
+  }
+
+  // ==================== 地址 ====================
+  private searchPrefix(): string {
+    if (this.searchEngine === 'baidu') {
+      return 'https://www.baidu.com/s?wd=';
+    }
+    if (this.searchEngine === 'google') {
+      return 'https://www.google.com/search?q=';
+    }
+    return 'https://www.bing.com/search?q=';
+  }
+
+  private resolveInput(input: string): string {
+    const text = input.trim();
+    if (text.length === 0) {
+      return '';
+    }
+    const lower = text.toLowerCase();
+    if (lower.startsWith('http://') || lower.startsWith('https://') || lower.startsWith('about:') ||
+      lower.startsWith('file:') || lower.startsWith('data:')) {
+      return text;
+    }
+    if (!text.includes(' ') && text.includes('.')) {
+      return 'https://' + text;
+    }
+    return this.searchPrefix() + encodeURIComponent(text);
+  }
+
+  private navigate(): void {
+    const target = this.resolveInput(this.urlInput);
+    if (target.length === 0) {
+      return;
+    }
+    this.urlInput = target;
+    this.updateActiveTab(null, target, true);
+    this.safe('loadURL', () => { servoshell.loadURL(target); });
+    this.persistSession();
+  }
+
+  private newTabNavigate(): void {
+    const target = this.resolveInput(this.newTabQuery);
+    if (target.length === 0) {
+      return;
+    }
+    this.newTabQuery = '';
+    this.onNewTab = false;
+    const tab = this.tabs[this.activeIndex()];
+    tab.isNewTab = false;
+    tab.canReturnToNewTab = true;
+    tab.history = [];
+    tab.historyIndex = -1;
+    tab.pendingNav = 0;
+    this.tabs = this.tabs.slice();
+    this.urlInput = target;
+    this.updateActiveTab(null, target, true);
+    this.startLoading();
+    this.loadInActiveTab(target);
+    this.persistSession();
+  }
+
+  private focusNewTabInput(): void {
+    try {
+      this.getUIContext().getFocusController().requestFocus('newtab-input');
+    } catch (error) {
+      JsLog.write('W', 'focus newtab failed');
+    }
+  }
+
+  /** 接收内核回传的站点图标："宽,高,格式:base64"。 */
+  private applyFavicon(payload: string): void {
+    const sep: number = payload.indexOf(':');
+    if (payload.startsWith('png:')) {
+      this.decodePngFavicon(payload.substring(4));
+      return;
+    }
+    if (sep <= 0) {
+      return;
+    }
+    const meta: string[] = payload.substring(0, sep).split(',');
+    if (meta.length < 3) {
+      return;
+    }
+    const width: number = parseInt(meta[0], 10);
+    const height: number = parseInt(meta[1], 10);
+    const format: number = parseInt(meta[2], 10);
+    if (!(width > 0) || !(height > 0)) {
+      return;
+    }
+    try {
+      const bytes = new util.Base64Helper().decodeSync(payload.substring(sep + 1));
+      const options: image.InitializationOptions = {
+        size: { width: width, height: height },
+        pixelFormat: format === 1 ? image.PixelMapFormat.BGRA_8888 : image.PixelMapFormat.RGBA_8888
+      };
+      image.createPixelMap(bytes.buffer, options).then((pixelMap: image.PixelMap) => {
+        const tab = this.tabs[this.activeIndex()];
+        tab.favicon = pixelMap;
+        this.tabs = this.tabs.slice();
+      }).catch(() => {
+      });
+    } catch (error) {
+      JsLog.write('W', 'favicon decode failed');
+    }
+  }
+
+  /** 内核以 PNG 交付图标：交给平台解码器，颜色不受通道顺序影响。 */
+  private decodePngFavicon(base64: string): void {
+    try {
+      const bytes = new util.Base64Helper().decodeSync(base64);
+      const source: image.ImageSource = image.createImageSource(bytes.buffer);
+      source.createPixelMap().then((pixelMap: image.PixelMap) => {
+        const tab = this.tabs[this.activeIndex()];
+        tab.favicon = pixelMap;
+        this.tabs = this.tabs.slice();
+      }).catch(() => {
+      });
+    } catch (error) {
+      JsLog.write('W', 'favicon png decode failed');
+    }
+  }
+
+  /** 按关键字过滤日志（大小写不敏感的逐行匹配）。 */
+  /** 进入调试页时才拉取日志，并分页渲染：一次渲染全部会卡住 UI。 */
+  private loadDebug(page: number): void {
+    this.debugLoading = true;
+    this.debugShown = page;
+    setTimeout(() => {
+      try {
+        const raw: string = servoshell.debugLogs();
+        this.debugLines = raw.length > 0 ? raw.split('\n') : [];
+      } catch (error) {
+        this.debugLines = [];
+      }
+      this.debugLoading = false;
+    }, 30);
+  }
+
+  private refreshDebug(page: number): void {
+    this.loadDebug(page);
+  }
+
+  private applyDebugSearch(): void {
+    this.debugAppliedQuery = this.debugQuery;
+    this.debugShown = DEBUG_PAGE;
+  }
+
+  private debugFiltered(): string[] {
+    const query: string = this.debugAppliedQuery.trim().toLowerCase();
+    if (query.length === 0) {
+      return this.debugLines;
+    }
+    const hits: string[] = [];
+    for (let i = 0; i < this.debugLines.length; i++) {
+      if (this.debugLines[i].toLowerCase().indexOf(query) >= 0) {
+        hits.push(this.debugLines[i]);
+      }
+    }
+    return hits;
+  }
+
+  private debugVisible(): string[] {
+    const all: string[] = this.debugFiltered();
+    const end: number = Math.min(this.debugShown, all.length);
+    return all.slice(0, end);
+  }
+
+  private expandDebug(): void {
+    this.debugShown = this.debugShown + DEBUG_PAGE;
+  }
+
+  private debugFullText(): string {
+    const logs: string = servoshell.debugLogs();
+    return this.debugHeader() + (logs.length > 0 ? logs : '暂无日志') + '\n';
+  }
+
+  private copyDebug(): void {
+    try {
+      const data: pasteboard.PasteData =
+        pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN, this.debugFullText());
+      pasteboard.getSystemPasteboard().setData(data).then(() => {
+        this.getUIContext().getPromptAction().showToast({ message: '日志已复制', duration: 1800 });
+      }).catch(() => {
+        this.getUIContext().getPromptAction().showToast({ message: '复制失败', duration: 1800 });
+      });
+    } catch (error) {
+      this.getUIContext().getPromptAction().showToast({ message: '复制失败', duration: 1800 });
+    }
+  }
+
+  /** 导出文件头部：版本、设备、系统、缩放、UA 等，方便直接贴 issue。 */
+  private debugHeader(): string {
+    let model: string = '';
+    let os: string = '';
+    let api: string = '';
+    try {
+      model = deviceInfo.productModel;
+      os = deviceInfo.osFullName;
+      api = String(deviceInfo.sdkApiVersion);
+    } catch (error) {
+    }
+    return 'Servo for HarmonyOS\n' +
+      'app_version : ' + APP_VERSION + '\n' +
+      'kernel      : Servo ' + KERNEL_VERSION + '\n' +
+      'bundle      : com.kevin.servoohos.browser\n' +
+      'device      : ' + model + '\n' +
+      'os          : ' + os + ' (api ' + api + ')\n' +
+      'screen_dpr  : ' + this.deviceDpr.toFixed(2) + '\n' +
+      'viewport    : ' + this.viewportInfo + '\n' +
+      'ime         : ' + this.imeInfo + '\n' +
+      'ua          : ' + this.userAgent + '\n' +
+      'exported_at : ' + new Date().toISOString() + '\n' +
+      '---- logs ----\n';
+  }
