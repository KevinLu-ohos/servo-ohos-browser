+      colors: [
+        ['#66FFFFFF', 0.00],
+        ['#4DFFFFFF', 0.04],
+        ['#26FFFFFF', 0.09],
+        ['#12FFFFFF', 0.15],
+        ['#00FFFFFF', 0.28],
+        ['#00FFFFFF', 0.85],
+        ['#1F000000', 1.00]
