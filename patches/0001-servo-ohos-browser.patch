+    JsLog.write('I', 'boot:2 ready');
+  }
+
+  aboutToDisappear(): void {
+    this.alive = false;
+    if (this.themeTimer >= 0) {
+      clearInterval(this.themeTimer);
+      this.themeTimer = -1;
+    }
+    if (this.hideTimer >= 0) {
+      clearTimeout(this.hideTimer);
+      this.hideTimer = -1;
+    }
+    if (this.restoreTimer >= 0) {
+      clearTimeout(this.restoreTimer);
+      this.restoreTimer = -1;
+    }
+    if (this.loadingTimer >= 0) {
+      clearTimeout(this.loadingTimer);
+      this.loadingTimer = -1;
+    }
+    if (this.sensorOn) {
+      try {
+        sensor.off(sensor.SensorId.AMBIENT_LIGHT);
+      } catch (error) {
+        JsLog.write('W', 'sensor off failed');
+      }
+      this.sensorOn = false;
+    }
+  }
+
+  private restoreSessionTabs(): void {
+    try {
+      const urls = Store.loadSession();
+      if (urls.length === 0) {
+        return;
+      }
+      for (let i = 0; i < urls.length && i < 6; i++) {
+        const url = urls[i];
+        if (url.length === 0) {
+          continue;
+        }
+        if (i === 0) {
+          this.tabs[0].url = url;
+          this.urlInput = url;
+          this.safe('loadURL', () => { servoshell.loadURL(url); });
+        } else {
+          const id = this.nextTabId++;
+          this.safe('nextWindowId', () => { servoshell.nextWindowId(id); });
+          const tab = new TabInfo(id);
+          tab.url = url;
+          this.tabs.push(tab);
+        }
+      }
+      this.tabs = this.tabs.slice();
+      JsLog.write('I', 'session restored');
+    } catch (error) {
+      JsLog.write('E', 'session restore failed');
+    }
+  }
