+  /**
+   * 自己驱动标签的加载状态：导航开始即转圈，结束（或 1.6s 超时）后停止并去取图标。
+   * 原因是内核的 load status / favicon 通知在本机没有稳定送达。
+   */
+  private startLoading(): void {
+    const tab = this.tabs[this.activeIndex()];
+    tab.loading = true;
+    this.loading = true;
+    this.tabs = this.tabs.slice();
+    if (this.loadingTimer >= 0) {
+      clearTimeout(this.loadingTimer);
+    }
+    this.loadingTimer = setTimeout(() => {
+      if (!this.alive) {
+        return;
+      }
+      this.loadingTimer = -1;
+      const current = this.tabs[this.activeIndex()];
+      current.loading = false;
+      this.loading = false;
+      this.tabs = this.tabs.slice();
+      this.fetchSiteIcon(current);
+    }, 1600);
+  }
+
+  /** 在“当前活动标签”里加载：先 focus 再 loadURL，避免命令落到别的 webview。 */
+  private loadInActiveTab(url: string): void {
+    const index: number = this.activeIndex();
+    this.safe('focusWebview', () => { servoshell.focusWebview(index, this.tabIds()); });
+    this.safe('loadURL', () => { servoshell.loadURL(url); });
+    // 新建的 webview 默认是浅色主题，加载后立刻同步一次系统深浅色。
+    this.safe('setPageTheme', () => { servoshell.setPageTheme(this.isDark); });
+  }
+
+  private originOf(u: string): string {
+    const idx: number = u.indexOf('://');
+    if (idx < 0) {
+      return '';
+    }
+    const rest: string = u.substring(idx + 3);
+    const slash: number = rest.indexOf('/');
+    if (slash < 0) {
+      return u;
+    }
+    return u.substring(0, idx + 3 + slash);
+  }
+
+  /** 内核没给 favicon 时，自己去找：页面声明的 icon → /favicon.ico。 */
+  private async fetchSiteIcon(tab: TabInfo): Promise<void> {
+    if (tab.favicon !== null || tab.isNewTab || tab.url.length === 0) {
+      return;
+    }
+    if (!tab.url.startsWith('http')) {
+      return;
+    }
+    const origin: string = this.originOf(tab.url);
+    let declared: string = '';
+    try {
+      declared = await this.evalResult(
+        '(function(){var l=document.querySelector(\'link[rel~="icon"],link[rel="shortcut icon"]\');' +
+        'return l&&l.href?l.href:"";})()');
+    } catch (error) {
+      declared = '';
+    }
+    if (declared.length > 0 &&
+      declared.indexOf('data:') !== 0 &&
+      declared.toLowerCase().indexOf('.svg') < 0) {
+      if (await this.tryLoadIcon(tab, declared)) {
+        return;
+      }
+    }
+    if (origin.length > 0) {
+      await this.tryLoadIcon(tab, origin + '/favicon.ico');
+    }
+  }
+
+  /** favicon.ico 里通常内嵌 PNG，取出最大的一张交给解码器。 */
+  private extractPngFromIco(buffer: ArrayBuffer): ArrayBuffer | null {
+    const bytes = new Uint8Array(buffer);
+    if (bytes.length < 22) {
+      return null;
+    }
+    if (bytes[0] !== 0 || bytes[1] !== 0 || bytes[2] !== 1 || bytes[3] !== 0) {
+      return null;
+    }
+    const count: number = bytes[4] | (bytes[5] << 8);
+    let bestSize: number = 0;
+    let bestOffset: number = 0;
+    let bestLength: number = 0;
+    for (let i = 0; i < count; i++) {
+      const base: number = 6 + i * 16;
+      if (base + 16 > bytes.length) {
+        break;
+      }
+      const width: number = bytes[base] === 0 ? 256 : bytes[base];
+      const length: number = bytes[base + 8] | (bytes[base + 9] << 8) |
+        (bytes[base + 10] << 16) | (bytes[base + 11] << 24);
+      const offset: number = bytes[base + 12] | (bytes[base + 13] << 8) |
+        (bytes[base + 14] << 16) | (bytes[base + 15] << 24);
+      if (length > 0 && offset + length <= bytes.length && width >= bestSize) {
+        bestSize = width;
+        bestOffset = offset;
+        bestLength = length;
+      }
+    }
+    if (bestLength === 0) {
+      return null;
+    }
+    if (bytes[bestOffset] === 0x89 && bytes[bestOffset + 1] === 0x50 &&
+      bytes[bestOffset + 2] === 0x4E && bytes[bestOffset + 3] === 0x47) {
+      return buffer.slice(bestOffset, bestOffset + bestLength);
+    }
+    return null;
+  }
+
+  private async tryLoadIcon(tab: TabInfo, iconUrl: string): Promise<boolean> {
+    let request: http.HttpRequest | null = null;
+    try {
+      request = http.createHttp();
+      const response = await request.request(iconUrl, {
+        method: http.RequestMethod.GET,
+        expectDataType: http.HttpDataType.ARRAY_BUFFER,
+        connectTimeout: 5000,
+        readTimeout: 5000,
+        usingCache: true,
+        header: { 'User-Agent': this.userAgent }
+      });
+      if (response.responseCode !== 200) {
+        return false;
+      }
+      const buffer = response.result as ArrayBuffer;
+      if (buffer === undefined || buffer.byteLength === 0 || buffer.byteLength > 512 * 1024) {
+        return false;
+      }
+      let pixelMap: image.PixelMap;
+      try {
+        const source = image.createImageSource(buffer);
+        pixelMap = await source.createPixelMap();
+        source.release();
+      } catch (decodeError) {
+        const png = this.extractPngFromIco(buffer);
+        if (png === null) {
+          JsLog.write('I', 'icon format unsupported');
+          return false;
+        }
+        const retry = image.createImageSource(png);
+        pixelMap = await retry.createPixelMap();
+        retry.release();
+      }
+      tab.favicon = pixelMap;
+      this.tabs = this.tabs.slice();
+      return true;
+    } catch (error) {
+      JsLog.write('W', 'icon fetch failed');
+      return false;
+    } finally {
+      if (request !== null) {
+        request.destroy();
+      }
+    }
+  }
+
+  /** 记录一次 URL 变化；后退/前进时只移动指针，不新增历史。 */
+  private recordHistory(url: string): void {
+    if (url.length === 0) {
+      return;
+    }
+    const tab = this.tabs[this.activeIndex()];
+    if (tab.pendingNav === -1) {
+      tab.pendingNav = 0;
+      if (tab.historyIndex > 0) {
+        tab.historyIndex = tab.historyIndex - 1;
+      }
+      this.tabs = this.tabs.slice();
+      return;
+    }
+    if (tab.pendingNav === 1) {
+      tab.pendingNav = 0;
+      if (tab.historyIndex + 1 < tab.history.length) {
+        tab.historyIndex = tab.historyIndex + 1;
+      }
+      this.tabs = this.tabs.slice();
+      return;
+    }
+    if (tab.historyIndex >= 0 && tab.historyIndex < tab.history.length &&
+      tab.history[tab.historyIndex] === url) {
+      return;
+    }
+    const kept: string[] = [];
+    for (let i = 0; i <= tab.historyIndex && i < tab.history.length; i++) {
+      kept.push(tab.history[i]);
+    }
+    kept.push(url);
+    tab.history = kept;
+    tab.historyIndex = kept.length - 1;
+    this.tabs = this.tabs.slice();
+  }
+
+  private canGoBackNow(): boolean {
+    const tab = this.tabs[this.activeIndex()];
+    return tab.historyIndex > 0 || tab.canReturnToNewTab || !this.onNewTab && tab.historyIndex > 0;
+  }
+
+  private canGoForwardNow(): boolean {
+    const tab = this.tabs[this.activeIndex()];
+    return tab.historyIndex + 1 < tab.history.length;
+  }
+
+  private goForwardSmart(): void {
+    const tab = this.tabs[this.activeIndex()];
+    if (tab.historyIndex + 1 >= tab.history.length) {
+      return;
+    }
+    tab.historyIndex = tab.historyIndex + 1;
+    const target: string = tab.history[tab.historyIndex];
+    tab.isNewTab = false;
+    this.onNewTab = false;
+    this.tabs = this.tabs.slice();
+    this.updateActiveTab(null, target, true);
+    this.urlInput = target;
+    this.startLoading();
+    this.loadInActiveTab(target);
+  }
+
+  /** 返回：优先 webview 历史；历史见底时回到我方新标签页。 */
+  private goBackSmart(): void {
+    if (this.view !== 'browser') {
+      this.backPanel();
+      return;
+    }
+    if (this.onNewTab) {
+      return;
+    }
+    const tab = this.tabs[this.activeIndex()];
+    if (tab.historyIndex > 0) {
+      tab.historyIndex = tab.historyIndex - 1;
+      const target: string = tab.history[tab.historyIndex];
+      this.tabs = this.tabs.slice();
+      this.updateActiveTab(null, target, true);
+      this.urlInput = target;
+      this.startLoading();
+      // 先用内核回退（能保留页面状态），400ms 内没回退成功就强制加载
+      this.safe('goBack', () => { servoshell.goBack(); });
+      setTimeout(() => {
+        if (!this.alive) {
+          return;
+        }
+        const current = this.tabs[this.activeIndex()];
+        if (current.url !== target) {
+          this.loadInActiveTab(target);
+        }
+      }, 400);
+      return;
+    }
+    if (tab.canReturnToNewTab) {
+      tab.canReturnToNewTab = false;
+      tab.isNewTab = true;
+      tab.url = '';
+      tab.title = '新标签页';
+      this.tabs = this.tabs.slice();
+      this.onNewTab = true;
+      this.urlInput = '';
+      this.newTabQuery = '';
+      this.persistSession();
+    }
+  }
+
+  private focusOmnibox(): void {
+    this.view = 'browser';
+    try {
+      this.getUIContext().getFocusController().requestFocus('omnibox');
+    } catch (error) {
+      JsLog.write('W', 'focus omnibox failed');
+    }
+  }
+
+  private persistSession(): void {
+    const urls: string[] = [];
+    for (let i = 0; i < this.tabs.length; i++) {
+      if (this.tabs[i].url.length > 0) {
+        urls.push(this.tabs[i].url);
+      }
+    }
+    try {
+      Store.saveSession(urls);
+    } catch (error) {
+      JsLog.write('W', 'save session failed');
+    }
+  }
+
+  private persistSettings(): void {
+    try {
+      Store.put('searchEngine', this.searchEngine);
+      Store.put('theme', this.themeMode);
+      Store.put('restoreSessionV2', this.restoreSession);
+      Store.put('homePage', this.homePage);
+      // 玻璃/材质开关已移除，不再持久化
+    } catch (error) {
+      JsLog.write('W', 'save settings failed');
+    }
+  }
+
+  /** 主题变化后统一应用：材质、页面 prefers-color-scheme 都要跟着走。 */
+  private applyThemeMode(): void {
+    this.syncSystemDark();
+    this.resolveTheme();
+    this.rebuildMaterials();
+    // 网页也要跟随系统深浅色（驱动 prefers-color-scheme）
+    this.safe('setPageTheme', () => {
+      servoshell.setPageTheme(this.isDark);
+    });
+  }
+
+  /**
+   * 把**系统**的明暗同步到 AppStorage.systemDark（图标前景色用）。
+   * 注意不能用 context.resourceManager.getConfigurationSync()：那是应用自己的配置，
+   * 深色系统下也可能报浅色，导致深色背景配黑色图标。
+   */
+  /**
+   * 设备真实是否深色。三级回退：
+   * 1) 系统级 ResourceManager（模块级 API，设备真实配置）
+   * 2) 应用配置
+   * 3) uiAppearance 的深色设置
+   * 不能用 context.resourceManager 单独判断：它可能一直报浅色。
+   */
+  private readSystemDark(): boolean {
+    try {
+      const sysManager: resourceManager.ResourceManager = resourceManager.getSystemResourceManager();
+      return sysManager.getConfigurationSync().colorMode === resourceManager.ColorMode.DARK;
+    } catch (error) {
+    }
+    try {
+      const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
+      return context.resourceManager.getConfigurationSync().colorMode ===
+        resourceManager.ColorMode.DARK;
+    } catch (error) {
+    }
+    try {
+      return uiAppearance.getDarkMode() === uiAppearance.DarkMode.ALWAYS_DARK;
+    } catch (error) {
+      return false;
+    }
+  }
+
+  /**
+   * 仅在 Ability 尚未上报过时兜底一次（用应用自身的配置）。
+   * 不能反复读系统级配置覆盖它：某些设备上那个值恒为浅色。
+   */
+  private syncSystemDark(): void {
+    if (this.systemDarkSynced) {
+      return;
+    }
+    this.systemDarkSynced = true;
+    try {
+      const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
+      const config = context.resourceManager.getConfigurationSync();
+      const dark: boolean = config.colorMode === resourceManager.ColorMode.DARK;
+      AppStorage.setOrCreate('systemDark', dark);
+    } catch (error) {
+    }
+  }
+
+  private resolveTheme(): void {
+    if (this.themeMode === 'dark') {
+      this.isDark = true;
+      return;
+    }
+    if (this.themeMode === 'light') {
+      this.isDark = false;
+      return;
+    }
+    // 跟随系统：直接用 Ability 通过 onConfigurationUpdate 写入的 systemDark。
+    // 之前改成读 getSystemResourceManager()，在部分设备上它恒定返回浅色，
+    // 结果把整个应用锁死在浅色模式。
+    this.isDark = this.systemDark;
+  }
+
+  private onSystemThemeChanged(): void {
+    // Ability 的 onConfigurationUpdate 已经把 systemDark 更新好了，这里直接重解析主题
+    this.systemDarkSynced = true;
+    if (this.themeMode === 'auto') {
+      this.applyThemeMode();
+    }
+    if (this.immersiveWanted) {
+      this.rebuildMaterials();
+    }
+  }
+
+  private onAmbientChanged(lux: number): void {
+    this.ambient = lux;
+    // 只有跨档位时才重建材质，避免传感器每秒触发原生对象创建
+    const bucket: number = lux < 40 ? 0 : (lux < 90 ? 1 : 2);
+    if (bucket === this.ambientBucket) {
+      return;
+    }
+    this.ambientBucket = bucket;
+    if (this.immersiveWanted) {
+      this.rebuildMaterials();
+    }
+  }
+
+  private applyCursor(id: number): void {
+    const style: pointer.PointerStyle = this.pointerStyleFor(id);
+    // 优先用系统级接口（CursorController 在部分设备上不生效）
+    if (this.windowId >= 0) {
+      try {
+        pointer.setPointerStyle(this.windowId, style).catch(() => {
+        });
+        return;
+      } catch (error) {
+        JsLog.write('W', 'setPointerStyle failed');
+      }
+    }
+    try {
+      this.getUIContext().getCursorController().setCursor(style);
+    } catch (error) {
+      JsLog.write('W', 'cursor controller failed');
+    }
+  }
+
+  private pointerStyleFor(id: number): pointer.PointerStyle {
+    if (id === 1) {
+      return pointer.PointerStyle.HAND_POINTING;
+    }
+    if (id === 2) {
+      return pointer.PointerStyle.TEXT_CURSOR;
+    }
+    if (id === 3) {
+      return pointer.PointerStyle.CURSOR_CROSS;
+    }
+    if (id === 4) {
+      return pointer.PointerStyle.MOVE;
+    }
+    if (id === 5) {
+      return pointer.PointerStyle.HAND_OPEN;
+    }
+    if (id === 6) {
+      return pointer.PointerStyle.HAND_GRABBING;
+    }
+    if (id === 7) {
+      return pointer.PointerStyle.CURSOR_FORBID;
+    }
+    if (id === 8 || id === 9) {
+      return pointer.PointerStyle.LOADING;
+    }
+    if (id === 11) {
+      return pointer.PointerStyle.HELP;
+    }
+    if (id === 12) {
+      return pointer.PointerStyle.CURSOR_COPY;
+    }
+    if (id === 14) {
+      return pointer.PointerStyle.RESIZE_LEFT_RIGHT;
+    }
+    if (id === 15) {
+      return pointer.PointerStyle.RESIZE_UP_DOWN;
+    }
+    return pointer.PointerStyle.DEFAULT;
+  }
+
+  private runUserScripts(): void {
+    for (let i = 0; i < this.scripts.length; i++) {
+      const s = this.scripts[i];
+      if (!s.enabled || s.code.length === 0) {
+        continue;
+      }
+      if (s.pattern === '*' || s.pattern.length === 0 || this.urlInput.includes(s.pattern)) {
+        this.safe('evalJs', () => { servoshell.evalJs(s.code); });
+      }
+    }
+  }
+
+  // ==================== 下载 ====================
+  private fileNameFor(url: string, suggested: string): string {
+    if (suggested.length > 0) {
+      let clean: string = suggested.replace(/[\\/:*?"<>|]/g, '_').trim();
+      if (clean.length > 120) {
+        clean = clean.substring(0, 120);
+      }
+      if (clean.length > 0) {
+        return clean;
+      }
+    }
+    let name = url;
+    const q = name.indexOf('?');
+    if (q >= 0) {
+      name = name.substring(0, q);
+    }
+    const slash = name.lastIndexOf('/');
+    if (slash >= 0) {
+      name = name.substring(slash + 1);
+    }
+    if (name.length === 0) {
+      name = 'download_' + Date.now().toString();
+    }
+    // 清洗非法字符，避免下载失败
+    name = name.replace(/[\\/:*?"<>|]/g, '_');
+    if (name.length > 120) {
+      name = name.substring(0, 120);
+    }
+    return name;
+  }
+
+  /** 把下载记录写进 Store，重启后仍能看到列表。 */
+  private persistDownloads(): void {
+    try {
+      const rows: DownloadRow[] = [];
+      for (let i = 0; i < this.downloads.length; i++) {
+        const item = this.downloads[i];
+        rows.push({
+          id: item.id,
+          name: item.name,
+          url: item.url,
+          progress: item.progress,
+          status: item.status,
+          path: item.path,
+          savedTo: item.savedTo,
+          received: item.received,
+          total: item.total
+        });
+      }
+      Store.put('downloads', JSON.stringify(rows));
+    } catch (error) {
+    }
+  }
+
+  /** 启动时恢复下载列表：未完成的标记为「已中断」，可一键重试。 */
+  private restoreDownloads(): void {
+    try {
+      const raw: string = Store.getString('downloads', '');
+      if (raw.length === 0) {
+        return;
+      }
+      const rows = JSON.parse(raw) as DownloadRow[];
+      if (rows.length === 0) {
+        return;
+      }
+      const items: DownloadItem[] = [];
+      let maxId: number = 0;
+      for (let i = 0; i < rows.length; i++) {
+        const row = rows[i];
+        const item = new DownloadItem(row.id, row.name, row.url, row.path);
+        item.savedTo = row.savedTo;
+        item.received = row.received;
+        item.total = row.total;
+        item.progress = row.progress;
+        if (row.status === DONE || row.status === SAVED || row.status === FAILED) {
+          item.status = row.status;
+        } else {
+          // 任务句柄无法跨进程恢复，交给用户重试
+          item.status = INTERRUPTED;
+          item.progress = 0;
+          item.received = 0;
+          item.speed = 0;
+        }
+        items.push(item);
+        maxId = Math.max(maxId, row.id);
+      }
+      this.downloads = items;
+      this.nextDownloadId = maxId + 1;
+    } catch (error) {
+    }
+  }
+
+  private patchDownload(id: number, progress: number, status: string): void {
+    // 失败状态会带错误码（"失败 401"），必须前缀匹配，否则 downloading 永远不复位
+    if (status.startsWith('已完成') || status.startsWith('已保存') ||
+      status.startsWith('失败') || status.startsWith('已取消')) {
+      this.downloading = false;
+      if (this.downloadGuard >= 0) {
+        clearTimeout(this.downloadGuard);
+        this.downloadGuard = -1;
+      }
+    }
+    for (let i = 0; i < this.downloads.length; i++) {
+      if (this.downloads[i].id === id) {
+        if (progress >= 0) {
+          this.downloads[i].progress = progress;
+        }
+        if (status.length > 0) {
+          this.downloads[i].status = status;
+        }
+      }
+    }
+    this.downloads = this.downloads.slice();
+    this.persistDownloads();
+  }
+
+  private startDownload(): void {
+    const url = this.dlUrl.trim();
+    if (url.length === 0) {
+      this.getUIContext().getPromptAction().showToast({ message: '请先输入或粘贴下载链接', duration: 2000 });
+      return;
+    }
+    const name = this.fileNameFor(url, this.pendingDownloadName);
+    this.pendingDownloadName = '';
+    const item = new DownloadItem(this.nextDownloadId++, name, url, '');
+    this.downloads = [item].concat(this.downloads);
+    this.persistDownloads();
+    this.dlUrl = '';
+    this.runDownload(item);
+  }
+
+  /**
+   * 默认下载目录：<用户下载目录>/servo。
+   * 该路径需要受限权限 READ_WRITE_DOWNLOAD_DIRECTORY（ACL），普通签名拿不到，
+   * 因此调用失败时返回空串，由调用方回退到系统文件选择器的下载模式。
+   */
+  private preferredDownloadDir(): string {
+    try {
+      const base = environment.getUserDownloadDir();
+      if (base.length === 0) {
+        return '';
+      }
+      const servoDir = base + '/servo';
+      try {
+        fileIo.mkdirSync(servoDir);
+      } catch (error) {
+        // 目录已存在
+      }
+      return servoDir;
+    } catch (error) {
+      JsLog.write('I', 'no download dir permission, will use picker');
+      return '';
+    }
+  }
+
+  /**
+   * 真实下载。
+   * 1) 有下载目录权限：直接写入 <下载目录>/servo/文件名；
+   * 2) 没有权限：打开系统文件选择器的“下载模式”（默认定位系统下载目录），
+   *    用户确认后拿到授权 URI，下载到沙箱再复制过去。
+   */
+  private async runDownload(item: DownloadItem): Promise<void> {
+    const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
+    try {
+      await this.performDownload(item, context);
+    } catch (error) {
+      JsLog.write('E', 'download failed');
+      this.patchDownload(item.id, -1, '失败');
+      this.getUIContext().getPromptAction().showToast({ message: '下载启动失败', duration: 2000 });
+    }
+  }
+
+  /** 同名文件自动加 (1)(2)…，对齐浏览器的“不覆盖已有文件”行为。 */
+  private uniquePath(dir: string, name: string): string {
+    if (dir.length === 0) {
+      return name;
+    }
+    const dot: number = name.lastIndexOf('.');
+    const stem: string = dot > 0 ? name.substring(0, dot) : name;
+    const ext: string = dot > 0 ? name.substring(dot) : '';
+    let candidate: string = dir + '/' + name;
+    let index: number = 1;
+    while (index < 500) {
+      try {
+        fileIo.accessSync(candidate);
+        candidate = dir + '/' + stem + ' (' + index.toString() + ')' + ext;
+        index = index + 1;
+      } catch (error) {
+        break;
+      }
+    }
+    return candidate;
+  }
+
+  /** 暂停 / 继续。 */
+  private togglePauseDownload(item: DownloadItem): void {
+    const task: request.DownloadTask | undefined = this.tasks.get(item.id);
+    if (!task) {
+      return;
+    }
+    if (item.status === PAUSED) {
+      task.resume().then(() => {
+        item.status = RUNNING;
+        this.downloads = this.downloads.slice();
+      }).catch(() => {
+      });
+    } else {
+      task.suspend().then(() => {
+        item.status = PAUSED;
+        this.downloads = this.downloads.slice();
+      }).catch(() => {
+      });
+    }
+  }
+
+  /** 取消：终止任务、删除未完成的临时文件，并从列表移除。 */
+  private cancelDownload(item: DownloadItem): void {
+    const task: request.DownloadTask | undefined = this.tasks.get(item.id);
+    if (task) {
+      task.delete().catch(() => {
+      });
+    }
+    this.tasks.delete(item.id);
+    if (item.status !== DONE && item.status !== SAVED) {
+      try {
+        fileIo.unlinkSync(item.path);
+      } catch (error) {
+      }
+    }
+    this.downloads = this.downloads.filter((it: DownloadItem) => it.id !== item.id);
+    this.downloads = this.downloads.slice();
+    this.persistDownloads();
+  }
+
+  /** 失败重试：重置进度后重新排队。 */
+  private retryDownload(item: DownloadItem): void {
+    this.tasks.delete(item.id);
+    item.received = 0;
+    item.total = 0;
+    item.speed = 0;
+    item.progress = 0;
+    item.status = '准备中';
+    this.downloads = this.downloads.slice();
+    this.runDownload(item);
+  }
+
+  /** 用系统能力打开已下载的文件；失败时把路径告诉用户。 */
+  private openDownloaded(item: DownloadItem): void {
+    const path: string = item.savedTo.length > 0 ? item.savedTo : item.path;
+    if (path.length === 0) {
+      return;
+    }
+    try {
+      const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
+      const uri: string = fileUri.getUriFromPath(path);
+      context.startAbility({
+        action: 'ohos.want.action.viewData',
+        uri: uri
+      }).catch(() => {
+        this.getUIContext().getPromptAction().showToast({ message: '无法打开：' + path, duration: 2600 });
+      });
+    } catch (error) {
+      this.getUIContext().getPromptAction().showToast({ message: '无法打开：' + path, duration: 2600 });
+    }
+  }
+
+  private async performDownload(item: DownloadItem, context: common.UIAbilityContext): Promise<void> {
+    // 有下载目录权限就直接写进去，否则回落到沙箱
+    const publicDir: string = this.downloadDirPath.length > 0 ?
+      this.downloadDirPath : Store.getString('downloadDirPath', '');
+    if (publicDir.length > 0) {
+      const directPath = this.uniquePath(publicDir, item.name);
+      item.path = directPath;
+      item.savedTo = directPath;
+      this.patchDownload(item.id, 0, '下载中');
+      this.downloads = this.downloads.slice();
+      request.downloadFile(context, {
+        url: item.url,
+        filePath: directPath,
+        header: {
+          'User-Agent': this.userAgent,
+          'Referer': this.tabs[this.activeIndex()].url
+        }
+      })
+        .then((task: request.DownloadTask) => {
+          this.tasks.set(item.id, task);
+          task.on('progress', (received: number, total: number) => {
+            item.updateBytes(received, total);
+            this.downloads = this.downloads.slice();
+          });
+          task.on('complete', () => {
+            this.patchDownload(item.id, 1, '已保存');
+          });
+          task.on('fail', () => {
+            JsLog.write('W', 'direct download failed, fallback to sandbox');
+            this.downloadToSandbox(item, context);
+          });
+        })
+        .catch((err: BusinessError) => {
+          JsLog.write('W', 'direct download rejected: ' + err.code);
+          this.downloadToSandbox(item, context);
+        });
+      return;
+    }
+
+    const sandboxDir = context.filesDir + '/downloads';
+    try {
+      fileIo.mkdirSync(sandboxDir);
+    } catch (error) {
+      // 已存在
+    }
+    const tmpPath = sandboxDir + '/' + item.name;
+    item.path = tmpPath;
+    item.savedTo = '';
+    this.patchDownload(item.id, 0, '下载中');
+    this.downloads = this.downloads.slice();
+
+    this.downloadToSandbox(item, context);
+  }
+
+  private downloadToSandbox(item: DownloadItem, context: common.UIAbilityContext): void {
+    const sandboxDir = context.filesDir + '/downloads';
+    try {
+      fileIo.mkdirSync(sandboxDir);
+    } catch (error) {
+      // 已存在
+    }
+    const tmpPath = this.uniquePath(sandboxDir, item.name);
+    item.path = tmpPath;
+    item.savedTo = '';
+    this.patchDownload(item.id, 0, '下载中');
+    this.downloads = this.downloads.slice();
+    request.downloadFile(context, {
+      url: item.url,
+      filePath: tmpPath,
+      header: {
+        'User-Agent': this.userAgent,
+        'Referer': this.tabs[this.activeIndex()].url
+      }
+    })
+      .then((task: request.DownloadTask) => {
+        this.tasks.set(item.id, task);
+        task.on('progress', (received: number, total: number) => {
+          item.updateBytes(received, total);
+          this.downloads = this.downloads.slice();
+        });
+        task.on('complete', () => {
+          this.patchDownload(item.id, 1, '已完成');
+          this.exportToPublicDir(item, tmpPath);
+        });
+        task.on('fail', () => {
+          this.patchDownload(item.id, -1, '失败');
+          this.getUIContext().getPromptAction()
+            .showToast({ message: '下载失败：' + item.name, duration: 2500 });
+        });
+      })
+      .catch((err: BusinessError) => {
+        this.patchDownload(item.id, -1, '失败 ' + err.code.toString());
+        this.getUIContext().getPromptAction()
+          .showToast({ message: '下载失败（' + err.code.toString() + '）', duration: 2500 });
+      });
+  }
+
+  /** 有下载目录权限时自动落到 <下载>/servo；没有就留在沙箱，等用户“另存到…”。 */
+  private exportToPublicDir(item: DownloadItem, tmpPath: string): void {
+    const dir: string = this.downloadDirUri.length > 0 ?
+      this.downloadDirUri : Store.getString('downloadDirUri', '');
+    if (dir.length === 0) {
+      return;
+    }
+    const withServo: string = dir + '/Servo/' + item.name;
+    if (this.copyToUri(tmpPath, withServo)) {
+      item.savedTo = withServo;
+      this.downloads = this.downloads.slice();
+      this.patchDownload(item.id, 1, '已保存');
+      return;
+    }
+    const plain: string = dir + '/' + item.name;
+    if (this.copyToUri(tmpPath, plain)) {
+      item.savedTo = plain;
+      this.downloads = this.downloads.slice();
+      this.patchDownload(item.id, 1, '已保存');
+    }
+  }
+
+  /** 启动即申请「下载目录」权限（READ_WRITE_DOWNLOAD_DIRECTORY）。 */
+  private async requestDownloadPermission(): Promise<boolean> {
+    try {
+      const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
+      const atManager = abilityAccessCtrl.createAtManager();
+      const perms: Permissions[] = ['ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY'];
+      const result = await atManager.requestPermissionsFromUser(context, perms);
+      for (let i = 0; i < result.authResults.length; i++) {
+        if (result.authResults[i] === 0) {
+          return true;
+        }
+      }
+      JsLog.write('I', 'download permission denied');
+      return false;
+    } catch (error) {
+      JsLog.write('E', 'download permission request failed');
+      return false;
+    }
+  }
+
+  /** 拿到「下载」目录并创建 Servo 子目录。 */
+  private applyDownloadDir(): string {
+    try {
+      const dir = environment.getUserDownloadDir();
+      if (dir.length === 0) {
+        return '';
+      }
+      const servoDir = dir + '/Servo';
+      try {
+        fileIo.mkdirSync(servoDir);
+      } catch (error) {
+        // 已存在
+      }
+      this.downloadDirPath = servoDir;
+      Store.put('downloadDirPath', servoDir);
+      JsLog.write('I', 'download dir ready');
+      return servoDir;
+    } catch (error) {
+      JsLog.write('I', 'getUserDownloadDir not permitted');
+      return '';
+    }
+  }
+
+  /** 启动流程：申请权限 → 准备 <下载>/Servo（静默，不打扰用户）。 */
+  private async initDownloadDir(): Promise<void> {
+    const granted: boolean = await this.requestDownloadPermission();
+    if (!granted) {
+      JsLog.write('I', 'download permission not granted, using sandbox');
+      return;
+    }
+    this.applyDownloadDir();
+  }
+
+  /**
+   * 下载目录：首次由用户选择文件夹并持久授权，之后启动只需重新激活。
+   */
+  private async ensureDownloadDir(interactive: boolean): Promise<string> {
+    const saved: string = Store.getString('downloadDirUri', '');
+    if (saved.length > 0) {
+      try {
+        await fileShare.activatePermission([{ uri: saved, operationMode: 7 }]);
+        this.downloadDirUri = saved;
+        return saved;
+      } catch (error) {
+        JsLog.write('W', 'activatePermission failed');
+      }
+    }
+    if (!interactive) {
+      return '';
+    }
+    try {
+      const context = this.getUIContext().getHostContext() as common.UIAbilityContext;
+      const docPicker = new picker.DocumentViewPicker(context);
+      const options = new picker.DocumentSelectOptions();
+      options.selectMode = picker.DocumentSelectMode.FOLDER;
+      options.authMode = true;
+      options.maxSelectNumber = 1;
+      const uris = await docPicker.select(options);
+      if (uris.length === 0) {
+        return '';
+      }
+      const uri = uris[0];
+      try {
+        await fileShare.persistPermission([{ uri: uri, operationMode: 7 }]);
+      } catch (error) {
+        JsLog.write('W', 'persistPermission failed');
+      }
+      try {
+        fileIo.mkdirSync(uri + '/Servo');
+      } catch (error) {
+        // 已存在或不支持
+      }
+      this.downloadDirUri = uri;
+      Store.put('downloadDirUri', uri);
+      return uri;
+    } catch (error) {
+      JsLog.write('W', 'folder picker cancelled');
+      return '';
+    }
+  }
+
+  /** 通过 fd 分块复制到 URI（copyFileSync 对授权 URI 不可靠）。 */
+  private copyToUri(src: string, destUri: string): boolean {
+    let srcFile: fileIo.File | null = null;
+    let destFile: fileIo.File | null = null;
+    try {
+      srcFile = fileIo.openSync(src, fileIo.OpenMode.READ_ONLY);
+      destFile = fileIo.openSync(destUri,
+        fileIo.OpenMode.READ_WRITE | fileIo.OpenMode.CREATE | fileIo.OpenMode.TRUNC);
+      const size: number = fileIo.statSync(src).size;
+      const chunk: number = 1024 * 1024;
+      const buffer = new ArrayBuffer(chunk);
+      let offset: number = 0;
+      while (offset < size) {
+        const want: number = Math.min(chunk, size - offset);
+        const read: number = fileIo.readSync(srcFile.fd, buffer, { offset: offset, length: want });
+        if (read <= 0) {
+          break;
+        }
+        fileIo.writeSync(destFile.fd, buffer, { offset: offset, length: read });
+        offset += read;
+      }
+      return true;
+    } catch (error) {
+      JsLog.write('E', 'copyToUri failed');
+      return false;
+    } finally {
+      if (srcFile !== null) {
+        fileIo.closeSync(srcFile);
+      }
+      if (destFile !== null) {
+        fileIo.closeSync(destFile);
+      }
+    }
+  }
+
+  private formatBytes(bytes: number): string {
+    if (!(bytes > 0)) {
+      return '0 B';
+    }
+    const units: string[] = ['B', 'KB', 'MB', 'GB', 'TB'];
+    let value: number = bytes;
+    let unit: number = 0;
+    while (value >= 1024 && unit < units.length - 1) {
+      value = value / 1024;
+      unit = unit + 1;
+    }
+    return value.toFixed(value >= 100 ? 0 : 1) + ' ' + units[unit];
+  }
+
+  private formatSpeed(bytesPerSecond: number): string {
+    return this.formatBytes(bytesPerSecond) + '/s';
+  }
+
+  private hasActiveDownload(): boolean {
+    for (let i = 0; i < this.downloads.length; i++) {
+      const status = this.downloads[i].status;
+      if (status === '准备中' || status === '下载中') {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private activeDownloadProgress(): number {
+    for (let i = 0; i < this.downloads.length; i++) {
+      const item = this.downloads[i];
+      if (item.status === '下载中') {
+        return item.progress * 100;
+      }
+    }
+    return 0;
+  }
+
+  /** 页面内触发下载：解码地址后走统一下载流程。 */
+  /**
+   * 网络层判定为下载（Content-Disposition / 不可渲染类型）时走这里。
+   * 载荷是「服务端文件名 \u001f url」或纯 url，不做百分号编解码。
+   */
+  private startServerDownload(payload: string): void {
+    let name: string = '';
+    let url: string = payload;
+    let navigation: boolean = false;
+    const sep: number = payload.indexOf('\u001f');
+    if (sep > 0) {
+      // <导航标记>\u001f<文件名>\u001f<url>
+      const parts: string[] = payload.split('\u001f');
+      navigation = parts.length >= 3 && parts[0] === '1';
+      name = parts.length >= 3 ? parts[1] : '';
+      url = parts.length >= 3 ? parts[2] : payload.substring(sep + 1);
+    }
+    if (url.length === 0 || url.startsWith('blob:') || url.startsWith('data:')) {
+      return;
+    }
+    if (this.isUrlDownloading(url)) {
+      return;
+    }
+    const item = new DownloadItem(this.nextDownloadId++, this.fileNameFor(url, name), url, '');
+    this.downloads = [item].concat(this.downloads);
+    this.persistDownloads();
+    this.runDownload(item);
+    // 只有“导航到附件页”才退回上一页；子资源下载不能动页面。
+    if (navigation) {
+      this.safe('goBack', () => {
+        servoshell.goBack();
+      });
+    }
+  }
+
+  private handlePageDownload(encoded: string): void {
+    // 载荷可能是「服务端建议的文件名 \u001f url」，文件名要优先使用。
+    let suggested: string = '';
+    if (encoded.indexOf('\u001f') > 0) {
+      const sep: number = encoded.indexOf('\u001f');
+      suggested = encoded.substring(0, sep);
+      encoded = encoded.substring(sep + 1);
+    }
+    this.pendingDownloadName = suggested;
+    if (encoded === 'blob') {
+      this.downloading = true;
+      this.handleBlobDownload().then(() => {
+        this.downloading = false;
+      });
+      return;
+    }
+    if (encoded === 'too-large') {
+      this.getUIContext().getPromptAction()
+        .showToast({ message: '文件超过 4MB，暂不支持该下载', duration: 2500 });
+      return;
+    }
+    if (encoded === 'fail') {
+      this.getUIContext().getPromptAction()
+        .showToast({ message: '下载失败：无法读取文件内容', duration: 2500 });
+      return;
+    }
+    let url: string = '';
+    try {
+      url = decodeURIComponent(encoded);
+    } catch (error) {
+      JsLog.write('W', 'decode download url failed');
+      return;
+    }
+    if (url.length === 0 || url.startsWith('blob:') || url.startsWith('data:')) {
