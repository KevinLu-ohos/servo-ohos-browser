+      this.tabs = this.tabs.slice();
+      return;
+    }
+    if (tab.pendingNav === 1) {
+      tab.pendingNav = 0;
+      if (tab.historyIndex + 1 < tab.history.length) {
+        tab.historyIndex = tab.historyIndex + 1;
+      }
+      this.tabs = this.tabs.slice();
+      return;
+    }
+    if (tab.historyIndex >= 0 && tab.historyIndex < tab.history.length &&
+      tab.history[tab.historyIndex] === url) {
+      return;
+    }
+    const kept: string[] = [];
+    for (let i = 0; i <= tab.historyIndex && i < tab.history.length; i++) {
