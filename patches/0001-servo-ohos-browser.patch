+
+    pub fn build(&self) -> TextConfig {
+        TextConfig {
+            // raw: config,
+            input_type: self.input_type,
+            enterkey_type: self.enterkey_type,
+            preview_text_support: self.preview_text_support,
+            selection: self.selection.clone(),
+            window_id: self.window_id,
