+    if keycode == KeyCode::KEY_F5 {
+        return Some(4);
+    }
+    if !ctrl {
+        return None;
+    }
+    if keycode == KeyCode::KEY_T {
+        Some(1)
+    } else if keycode == KeyCode::KEY_W {
+        Some(2)
+    } else if keycode == KeyCode::KEY_L {
+        Some(3)
+    } else if keycode == KeyCode::KEY_R {
+        Some(4)
+    } else if keycode == KeyCode::KEY_TAB {
+        Some(5)
+    } else {
+        None
+    }
+}
