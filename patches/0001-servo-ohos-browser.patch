+          const tab = this.tabs[this.activeIndex()];
+          if (tab.isNewTab) {
+            tab.isNewTab = false;
+            tab.canReturnToNewTab = true;
+            this.tabs = this.tabs.slice();
+          }
+        }
+        const newUrl: string = rawUrl === NEW_TAB_URL ? '' : rawUrl;
+        // 站点用 location.href / 表单跳到文件地址时，改成下载并退回原页
+        if (this.isDownloadUrl(newUrl) && !this.downloading) {
+          this.handlePageDownload(encodeURIComponent(newUrl));
+          this.safe('goBack', () => { servoshell.goBack(); });
+          return;
+        }
+        const currentTab = this.tabs[this.activeIndex()];
+        if (currentTab.url !== newUrl) {
+          currentTab.favicon = null;
+        }
+        this.updateActiveTab(null, newUrl, null);
