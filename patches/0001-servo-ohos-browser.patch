+
+  // ==================== 玻璃外壳 ====================
+  @Builder
+  glassTop() {
+    // 顶部 1px 高光：模拟玻璃厚度，让"玻璃"可见（不依赖系统模糊）
+    Row()
+      .width('100%')
+      .height(1)
+      .linearGradient({
+        angle: 90,
+        colors: [[this.highlight(), 0.0], ['#00FFFFFF', 0.55], [this.highlight(), 1.0]]
+      })
+  }
+
+  // ==================== 顶栏内容 ====================
+  @Builder
+  tabPill(tab: TabInfo, index: number) {
+    Row({ space: 8 }) {
+      if (tab.loading) {
+        // 加载中：标签最左边转圈（与 Chrome 一致）
+        LoadingProgress().width(16).height(16).color(ACCENT)
+      } else if (tab.isNewTab) {
+        // 主页：Servo 图标
+        Image($r('app.media.servo_64'))
+          .width(17)
+          .height(17)
+          .objectFit(ImageFit.Contain)
+          .draggable(false)
+      } else if (tab.favicon !== null) {
+        // 站点返回的 favicon
+        Image(tab.favicon)
+          .width(17)
+          .height(17)
+          .objectFit(ImageFit.Contain)
+          .borderRadius(3)
+          .draggable(false)
+      } else {
+        // 没有 favicon 时用首字母兜底
+        Text(tab.title.length > 0 ? tab.title.substring(0, 1) : '?')
+          .fontSize(10)
+          .fontColor(Color.White)
+          .width(17)
+          .height(17)
+          .textAlign(TextAlign.Center)
+          .borderRadius(3)
+          .backgroundColor(ACCENT)
+      }
+
+      Column() {
+        Text(tab.title)
+          .fontSize(13)
+          .fontColor(this.activeId === tab.id ? this.fg() : this.fgDim())
+          .maxLines(1)
+          .textOverflow({ overflow: TextOverflow.Ellipsis })
+          .width('100%')
+      }
+      .height(24)
+      .justifyContent(FlexAlign.Center)
+      .alignItems(HorizontalAlign.Start)
+      .layoutWeight(1)
+
+      if (this.activeId === tab.id || this.hoveredKey === 'tab' + index) {
+        Column() {
+          GlyphIcon({
+            glyph: 'close',
+            iconSize: 17,
+            iconStroke: 2,
+            iconColor: this.fgDim(),
+            alignToText: false,
+            shiftX: 3.0,
+            shiftY: 2.6
