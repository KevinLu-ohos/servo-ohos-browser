+    .height(38)
+    .padding({ left: 12, right: 8 })
+    .alignItems(VerticalAlign.Center)
+    .translate({ x: this.tabShift(index) })
+    .borderRadius(12)
+    // 拖动时这一个矩形本身是“液态玻璃”：高斯模糊 + 提高饱和度/亮度 + 半透明底色，
+    // 外面再套一圈更亮的描边模拟向内折射。
+    // 这台设备的 ArkUI 背景模糊（backdropBlur/backgroundEffect）实测不生效，
+    // 所以玻璃质感改为自绘：斜向高光渐变 + 亮描边 + 半透明白底 + 深投影。
+    // 参考 iOS Liquid Glass：镜面高光贴着上缘（很窄的一条），
+    // 玻璃体中部几乎完全通透，下缘用暗色内阴影压出厚度。
+    // 只保留贴上缘的一条镜面高光，其余通透；多停靠点避免色带(锯齿感)
+    .linearGradient(this.dragIndex === index ? {
