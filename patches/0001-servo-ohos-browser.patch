+/**
+ * 设置页左侧导航项。
+ * 必须用真正的 @Component（@Prop）而不是 @Builder：ArkUI 的 @Builder 参数是
+ * 按值传递，状态变化不会引发内部重绘 —— 之前“只有外观的图标是蓝色、切换无效”
+ * 就是这个原因。
+ */
+@Component
+struct SideNavRow {
+  @Prop label: string = '';
+  @Prop glyph: string = '';
+  @Prop active: boolean = false;
+  @Prop fgColor: string = '#202124';
+  @Prop accentColor: string = '#1A73E8';
+  @Prop softColor: string = '#E8F0FE';
+  onTap: () => void = () => {};
+
+  build() {
+    Row({ space: 10 }) {
+      Stack({ alignContent: Alignment.Center }) {
+        Shape() {
+          Path()
+            .commands(glyphPathFor(this.glyph))
+            .stroke(this.active ? this.accentColor : this.fgColor)
+            .strokeWidth(1.9)
+            .fill(Color.Transparent)
+            .strokeLineCap(LineCapStyle.Round)
+            .strokeLineJoin(LineJoinStyle.Round)
+        }
+        .width(24)
+        .height(24)
+        .viewPort({ x: 0, y: 0, width: 24, height: 24 })
+        .offset({ y: 2.5 })
+      }
+      .width(24)
+      .height(24)
+
+      Text(this.label)
+        .fontSize(14.5)
+        .fontColor(this.active ? this.accentColor : this.fgColor)
+        .layoutWeight(1)
+    }
+    .width('100%')
+    .height(46)
+    .padding({ left: 14, right: 12 })
+    .borderRadius(10)
+    .backgroundColor(this.active ? this.softColor : Color.Transparent)
+    .animation({ curve: curves.springMotion(0.4, 0.85), duration: 220 })
+    .hoverEffect(HoverEffect.Highlight)
+    .onClick(() => {
+      this.onTap();
+    })
+  }
+}
