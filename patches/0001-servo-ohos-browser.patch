+  /** 把完整日志写成单个文本文件，优先放到「下载/Servo」，没有授权则落到应用沙箱。 */
+  private exportDebug(): void {
+    const text: string = this.debugFullText();
+    const stamp: string = new Date().toISOString().replace(/[:.]/g, '-');
+    const name: string = 'servo-log-v' + APP_VERSION + '-' + stamp + '.txt';
+    const publicDir: string = this.downloadDirPath.length > 0 ?
+      this.downloadDirPath : Store.getString('downloadDirPath', '');
+    let dir: string = publicDir;
+    if (dir.length === 0) {
+      try {
+        const context = getContext(this) as common.UIAbilityContext;
+        dir = context.filesDir;
+      } catch (error) {
+        dir = '';
+      }
+    }
+    if (dir.length === 0) {
+      this.getUIContext().getPromptAction().showToast({ message: '导出失败：没有可写目录', duration: 2200 });
+      return;
+    }
+    const path: string = dir + '/' + name;
+    try {
+      const file = fileIo.openSync(path,
+        fileIo.OpenMode.READ_WRITE | fileIo.OpenMode.CREATE | fileIo.OpenMode.TRUNC);
+      fileIo.writeSync(file.fd, text);
+      fileIo.closeSync(file);
+      this.getUIContext().getPromptAction().showToast({ message: '已导出：' + path, duration: 2600 });
+    } catch (error) {
+      JsLog.write('W', 'export log failed');
+      this.getUIContext().getPromptAction().showToast({ message: '导出失败', duration: 2000 });
+    }
+  }
