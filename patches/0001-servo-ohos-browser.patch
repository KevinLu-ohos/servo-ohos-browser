+        }
+        .width('100%')
+        .height(this.progressVisible ? 2 : 0)
+        .clip(true)
+        .animation({ curve: soft(), duration: 240 })
+
+        Stack() {
+          ForEach(this.tabs, (tab: TabInfo) => {
+            XComponent({
+              id: 'servo-window-' + tab.id,
+              type: XComponentType.SURFACE,
+              libraryname: 'servoshell'
+            })
+              .width('100%')
+              .height('100%')
+              .visibility(this.activeId === tab.id && !this.onNewTab ?
+                Visibility.Visible : Visibility.Hidden)
+              .focusable(true)
+              .focusOnTouch(true)
+              .onHover((isHover: boolean) => {
+                if (isHover) {
+                  this.focusKeyCatcher();
+                } else {
